# ============================================================
#  LYKOS CHAT - Variables de entorno (copia a .env)
#  Para Dokploy: configurar estas variables en el panel de Dokploy
#  (Environment Variables), NO en un archivo .env.
# ============================================================

# --- Entorno ---
# development o production. En production se activan guards de seguridad.
NODE_ENV=production

# --- Servidor ---
# PORT: Dokploy lo provee automaticamente. NO hardcodear.
PORT=3000
# URL publica donde escucha este servidor (la que pegas en Meta).
# En desarrollo local usa ngrok:  PUBLIC_URL=https://xxxx.ngrok-free.app
# En produccion: PUBLIC_URL=https://tu-dominio.com
PUBLIC_URL=https://tu-dominio.com

# --- CORS ---
# '*' para desarrollo, o lista de origenes separados por coma para produccion.
# Ej: CORS_ORIGIN=https://lykos.mx,https://app.lykos.mx
CORS_ORIGIN=https://tu-dominio.com

# --- Base de datos (SQLite) ---
# En Dokploy: asegurar que el directorio data/ sea un volumen persistente.
DB_PATH=./data/lykos.db

# --- Auth / JWT ---
# En produccion OBLIGATORIO: cadena aleatoria larga (no usar el default).
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Sesion ---
# Timeout de inactividad en minutos. 0 = deshabilitado.
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- Cifrado de credenciales en BD ---
# 32 bytes en hex (64 caracteres). OBLIGATORIO en produccion.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADVERTENCIA: NO cambiar esta clave despues del primer deploy o las
# credenciales cifradas en la BD no podran descifrarse.
ENCRYPTION_KEY=

# --- Credenciales por defecto del admin inicial (seed) ---
# En produccion OBLIGATORIO: contraseña segura (min 8 chars, mayuscula, minuscula, numero).
# Solo se usan en el primer deploy (seed). Despues se gestionan desde el panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Webhook: verify token inicial (editable luego desde el panel) ---
WEBHOOK_VERIFY_TOKEN=lykos_verify_token_inicial

# ============================================================
#  NOTAS PARA DOKPLOY
# ============================================================
# 1. Tipo de deployment: Node.js (usa Procfile + nixpacks.toml)
# 2. Volumenes persistentes obligatorios:
#    - data/        (base de datos SQLite)
#    - public/uploads/  (archivos subidos por agentes)
# 3. El comando release del Procfile ejecuta seed automaticamente.
# 4. Node.js 22 es obligatorio (node:sqlite). nixpacks.toml lo especifica.
# 5. Después del primer deploy, ingresar credenciales de WhatsApp e IA
#    desde el panel web (no se migran automaticamente).
